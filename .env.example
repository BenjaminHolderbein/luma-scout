# Copy to .env and fill in. .env is gitignored (this repo is public).

# ntfy topic to publish to. Anyone who knows this string can read/publish,
# so keep it out of the committed code (this file ships a placeholder only).
NTFY_TOPIC=your-topic-here

# ntfy server (default is the public one)
NTFY_SERVER=https://ntfy.sh

# Where the rendered report is published (the ntfy teaser links here).
REPORT_URL=https://benjaminholderbein.github.io/luma-scout/

# Claude model alias used for ranking (sonnet | opus | haiku)
RANK_MODEL=sonnet

# Horizon for the weekly report...
WINDOW_DAYS=7
# ...and the longer one for hackathons, which need registration lead time.
HACKATHON_WINDOW_DAYS=30

# Cap on events in the report. Hackathons are exempt -- they are never trimmed.
MAX_PER_REPORT=40
