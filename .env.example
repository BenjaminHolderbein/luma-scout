# Copy to .env and fill in. .env is gitignored (this repo is public).

# ntfy topic to publish to. Anyone who knows this string can read/publish,
# so keep it out of the committed code (this file ships a placeholder only).
NTFY_TOPIC=your-topic-here

# ntfy server (default is the public one)
NTFY_SERVER=https://ntfy.sh

# Where the rendered report is published (the ntfy teaser links here).
REPORT_URL=https://benjaminholderbein.github.io/luma-scout/

# Claude model alias used for ranking (sonnet | opus | haiku)
RANK_MODEL=sonnet

# Horizon for the weekly report...
WINDOW_DAYS=7
# ...and the longer one for hackathons, which need registration lead time.
# 60 rather than 30 because real Bay hackathons show up on Devpost/MLH with
# registration open 5-8 weeks out.
HACKATHON_WINDOW_DAYS=60

# Quality cutoff. Events below this Fortnite-style rarity are left out:
#   junk < common < uncommon < rare < epic < legendary
# The default shows commons as gray filler cards and hides only junk. Raise
# it to 'uncommon' or 'rare' for a shorter, punchier report; drop it to
# 'junk' to show absolutely everything. Hackathons are exempt -- they are
# always listed, whatever their rarity.
MIN_RARITY=common

# Backstop cap so a freak week can't produce a hundred-card page. The rarity
# cutoff above is what normally controls length. Hackathons are exempt.
MAX_PER_REPORT=60
